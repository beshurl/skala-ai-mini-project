# Credentials: only commit the empty configuration template.
.env
.env.*
!.env.example
!.env.*.example
.envrc
credentials*.json
*service-account*.json
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.keystore

# Python, frontend and editor caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
*.egg-info/
node_modules/
dist/
.vite/
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local conversations, vector indexes, runtime logs and model downloads.
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.log
*.bak
*.backup
*.safetensors
*.gguf
*.onnx
*.ckpt
*.pt
*.pth
models/
checkpoints/

# Only the project's explicit synthetic fixtures and runbooks are public.
/data/*
!/data/monitoring.json
!/data/logs.json
!/data/snapshots.json
!/data/investigation_cases.json
!/data/response_policy.json
!/data/runbooks/

# Keep evaluation evidence and report screenshots; omit authoring scratch files.
/artifacts/*_build/
/artifacts/ppt_output/
/artifacts/final_docs_20261021/*
!/artifacts/final_docs_20261021/verification.json
!/artifacts/final_docs_20261021/ppt/
/artifacts/final_docs_20261021/ppt/*
!/artifacts/final_docs_20261021/ppt/previews/
