# Copy to .env. Real credentials belong only in .env (gitignored).
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3.5:2b
OLLAMA_QUALITY_MODEL=qwen3.5:2b
OLLAMA_CONTEXT_LENGTH=16384
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Actual separate evaluator; no fake substitution.
JUDGE_BACKEND=ollama
JUDGE_MODEL=qwen3:8b
JUDGE_TIMEOUT_SECONDS=180

# Set a valid LangSmith key for remote tracing and feedback read-back.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone-all-total-live
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional OpenAI backend (billed API); not exercised in saved live results.
# LLM_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o-mini
# JUDGE_BACKEND=openai
# JUDGE_MODEL=gpt-4o

RAG_BACKEND=fastembed
RAG_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOOL_TIMEOUT_SECONDS=8
REQUEST_TIMEOUT_SECONDS=180
AGENT_PORT=18100
FRONTEND_PORT=8600
# SESSION_DB=/absolute/path/session.db
