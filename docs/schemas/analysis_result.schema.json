{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "label": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT"
          ],
          "title": "Label",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "validation_notes": {
          "items": {
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "label",
        "evidence_ids",
        "rationale"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "evidence_version": {
      "minimum": 1,
      "title": "Evidence Version",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "type": "string"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model": {
      "additionalProperties": true,
      "title": "Model",
      "type": "object"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    },
    "provenance": {
      "enum": [
        "local_mlx",
        "deterministic_fixture"
      ],
      "title": "Provenance",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "evidence_version",
    "findings",
    "limitations",
    "model",
    "usage",
    "provenance"
  ],
  "title": "AnalysisResult",
  "type": "object"
}