# Export explicitly; the app does not load this file automatically.
# Relative service paths below are anchored to the project root, even from backend/.
RECASE_BACKEND=mlx
RECASE_ADAPTER=outputs/mlx_adapter
RECASE_DB=runtime/recase.sqlite3
RECASE_ACCOUNTS_DB=runtime/recase.accounts.sqlite3
RECASE_DELETIONS=runtime/deletions.jsonl
# Administrator accounts are created privately with backend/scripts/accounts.py.
# Never put passwords in environment variables or in VITE_*.
# fixture is for explicit tests only. It is clearly labeled in the UI.
# No cloud LLM/API keys or tracing services are used.
# Optional local reference corpus. Keep unset until per-document hash-bound
# processing/rag/display + human privacy reviews pass. No raw quarantine default.
# RECASE_REFERENCE_CORPUS=/absolute/private/approved-references.jsonl
# RECASE_REFERENCE_REVIEWS=/absolute/private/reference-reviews.jsonl
